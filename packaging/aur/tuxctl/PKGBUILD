# Maintainer: Seqat <37043095+Seqat@users.noreply.github.com>

pkgname=tuxctl
pkgver=0.3.3
pkgrel=1
pkgdesc='A lightweight, keyboard-first Linux TUI for system monitoring and management'
arch=('x86_64' 'aarch64')
url='https://github.com/Seqat/tuxctl'
license=('MIT')
depends=('gcc-libs' 'glibc' 'systemd')
makedepends=('cargo')
optdepends=('nvidia-utils: temperature and usage of NVIDIA GPUs through NVML')
# The release profile already strips the binary, so a -debug package would be empty.
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::https://static.crates.io/crates/$pkgname/$pkgname-$pkgver.crate")
sha256sums=('89cb9753eb45e20ce5b849b4ea1c25b546d980ea81ee4ef4120f8239d4a53178')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # No --all-features: `redraw-counter` is a development-only feature.
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/tuxctl "$pkgdir/usr/bin/tuxctl"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
}
