# Maintainer: Seqat <37043095+Seqat@users.noreply.github.com>

pkgname=tuxctl-bin
_pkgname=tuxctl
pkgver=0.3.4
pkgrel=1
pkgdesc='A lightweight, keyboard-first Linux TUI for system monitoring and management (static binary; no NVIDIA NVML support)'
arch=('x86_64' 'aarch64')
url='https://github.com/Seqat/tuxctl'
license=('MIT')
# Statically linked (musl): no C library dependency.
depends=('systemd')
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
options=('!debug' '!strip')
_base="$url/releases/download/v$pkgver"
source_x86_64=("$_pkgname-$pkgver-x86_64.tar.gz::$_base/$_pkgname-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("$_pkgname-$pkgver-aarch64.tar.gz::$_base/$_pkgname-aarch64-unknown-linux-musl.tar.gz")
# From SHA256SUMS on the GitHub release.
sha256sums_x86_64=('458d23fca0bba5d2ef0833701e4bef5095c810c043f1b8001daf07689f6da296')
sha256sums_aarch64=('ab92cb6b10e5ffba227e64d05e1877da9d91acd975a5e2ba2e7b9dc06b80c3af')

package() {
  cd "$_pkgname-$CARCH-unknown-linux-musl"
  install -Dm755 tuxctl "$pkgdir/usr/bin/tuxctl"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
}
